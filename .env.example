# Cổng máy chủ (mặc định 3000)
PORT=3000

# Địa chỉ công khai dùng để tạo liên kết trong email đặt lại mật khẩu
# PUBLIC_URL=https://ditu.example.com

# Khoá ký token — nếu bỏ trống sẽ tự sinh và lưu tại data/secret.key
# AUTH_SECRET=...

# Thư mục dữ liệu SQLite (mặc định ./data)
# DATA_DIR=./data

# SMTP gửi email quên mật khẩu (nếu không cấu hình, liên kết sẽ in ra console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# MAIL_FROM="Đi Tu Online <no-reply@example.com>"
